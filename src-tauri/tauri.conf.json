{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApexNorth",
  "version": "0.1.0",
  "identifier": "com.elevennorth.apexnorth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ApexNorth",
        "width": 1280,
        "height": 720,
        "minWidth": 900,
        "minHeight": 520,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tts/": "tts/"
    },
    "category": "Utility",
    "shortDescription": "GT7 live telemetry and race engineer",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "copyright": "\u00a9 2026 Eleven North. Free for noncommercial use (PolyForm Noncommercial 1.0.0).",
    "license": "PolyForm-Noncommercial-1.0.0",
    "licenseFile": "../LICENSE"
  }
}
