<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- In-app updates: hand the downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ only lets the app bind to a text-to-speech engine it declares it looks for. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>
        <provider
            android:name="com.elevennorth.apexnorth.device.UpdateFileProvider"
            android:authorities="${applicationId}.apexnorth.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apexnorth_update_paths" />
        </provider>
    </application>
</manifest>
